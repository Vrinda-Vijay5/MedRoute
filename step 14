from mininet.net import Mininet
from mininet.node import OVSKernelSwitch, RemoteController
from mininet.link import TCLink
from mininet.log import setLogLevel

import time
import re


def extract_ping_metrics(output):

    metrics = {
        "packet_loss": None,
        "min_latency": None,
        "avg_latency": None,
        "max_latency": None,
        "individual_rtts": []
    }

    # ------------------------------------------
    # Extract packet loss
    # ------------------------------------------

    loss_match = re.search(
        r"(\d+(?:\.\d+)?)% packet loss",
        output
    )

    if loss_match:

        metrics["packet_loss"] = float(
            loss_match.group(1)
        )

    # ------------------------------------------
    # Extract min / avg / max latency
    # ------------------------------------------

    latency_match = re.search(
        r"=\s*([\d.]+)/([\d.]+)/([\d.]+)/",
        output
    )

    if latency_match:

        metrics["min_latency"] = float(
            latency_match.group(1)
        )

        metrics["avg_latency"] = float(
            latency_match.group(2)
        )

        metrics["max_latency"] = float(
            latency_match.group(3)
        )

    # ------------------------------------------
    # Extract individual RTT values
    # ------------------------------------------

    rtts = re.findall(
        r"time[=<]([\d.]+)\s*ms",
        output
    )

    metrics["individual_rtts"] = [
        float(value)
        for value in rtts
    ]

    return metrics


def display_metrics(metrics):

    print("\n================================")
    print("MedRoute SDN QoS Measurements")
    print("================================")

    if metrics["packet_loss"] is not None:

        print(
            "Packet Loss      :",
            metrics["packet_loss"],
            "%"
        )

    if metrics["min_latency"] is not None:

        print(
            "Minimum Latency  :",
            metrics["min_latency"],
            "ms"
        )

    if metrics["avg_latency"] is not None:

        print(
            "Average Latency  :",
            metrics["avg_latency"],
            "ms"
        )

    if metrics["max_latency"] is not None:

        print(
            "Maximum Latency  :",
            metrics["max_latency"],
            "ms"
        )

    print(
        "Individual RTTs   :",
        metrics["individual_rtts"]
    )

    print("================================")


def run():

    # ==========================================
    # CREATE MININET
    # ==========================================

    net = Mininet(
        switch=OVSKernelSwitch,
        link=TCLink,
        controller=None
    )

    # ==========================================
    # REMOTE RYU CONTROLLER
    # ==========================================

    net.addController(
        "c0",
        controller=RemoteController,
        ip="127.0.0.1",
        port=6653
    )

    # ==========================================
    # HOSTS
    # ==========================================

    h1 = net.addHost(
        "h1",
        ip="10.0.0.1/8"
    )

    h2 = net.addHost(
        "h2",
        ip="10.0.0.2/8"
    )

    # ==========================================
    # SWITCHES
    # ==========================================

    s1 = net.addSwitch(
        "s1",
        protocols="OpenFlow13"
    )

    s2 = net.addSwitch(
        "s2",
        protocols="OpenFlow13"
    )

    s3 = net.addSwitch(
        "s3",
        protocols="OpenFlow13"
    )

    s4 = net.addSwitch(
        "s4",
        protocols="OpenFlow13"
    )

    # ==========================================
    # HOST LINKS
    #
    # Keep these FIRST.
    # This guarantees:
    #
    # h1 -> s1 port 1
    # h2 -> s4 port 1
    #
    # Our Ryu controller currently expects this.
    # ==========================================

    net.addLink(
        h1,
        s1
    )

    net.addLink(
        h2,
        s4
    )

    # ==========================================
    # INTER-SWITCH LINKS
    #
    # Delay is intentionally added so that
    # network latency is measurable.
    # ==========================================

    net.addLink(
        s1,
        s2,
        bw=10,
        delay="5ms"
    )

    net.addLink(
        s2,
        s4,
        bw=10,
        delay="5ms"
    )

    net.addLink(
        s1,
        s3,
        bw=10,
        delay="10ms"
    )

    net.addLink(
        s3,
        s4,
        bw=10,
        delay="10ms"
    )

    # ==========================================
    # START NETWORK
    # ==========================================

    net.start()

    print("\nWaiting for SDN topology discovery...")

    time.sleep(5)

    # ==========================================
    # LATENCY TEST
    # ==========================================

    print("\n================================")
    print("MedRoute Step 14")
    print("SDN Latency Measurement")
    print("================================")

    print(
        "\nSending 10 ICMP packets "
        "from h1 to h2...\n"
    )

    ping_output = h1.cmd(
        "ping -c 10 -i 0.2 10.0.0.2"
    )

    print(ping_output)

    # ==========================================
    # PARSE RESULTS
    # ==========================================

    metrics = extract_ping_metrics(
        ping_output
    )

    display_metrics(
        metrics
    )

    # ==========================================
    # KEEP NETWORK ALIVE
    # ==========================================

    input(
        "\nPress ENTER to stop Mininet..."
    )

    net.stop()


if __name__ == "__main__":

    setLogLevel("info")

    run()

