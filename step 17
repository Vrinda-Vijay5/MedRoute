class QoSCostCalculator:

    def __init__(self):

        # ====================================================
        # NORMALIZATION LIMITS
        # ====================================================

        # Experimental upper bounds used by the prototype.
        # Values above these limits are capped at 1.0.

        self.max_delay_ms = 100.0
        self.max_jitter_ms = 50.0
        self.max_packet_loss_percent = 100.0

        # ====================================================
        # QoS COST WEIGHTS
        # ====================================================

        self.weight_delay = 0.30
        self.weight_jitter = 0.20
        self.weight_loss = 0.30
        self.weight_utilization = 0.20


    # ========================================================
    # GENERIC NORMALIZATION
    # ========================================================

    def normalize(self, value, maximum):

        if value is None:
            return 0.0

        if maximum <= 0:
            return 0.0

        normalized = value / maximum

        # Keep value between 0 and 1
        normalized = max(
            0.0,
            min(normalized, 1.0)
        )

        return normalized


    # ========================================================
    # UTILIZATION
    # ========================================================

    def calculate_utilization(
        self,
        traffic_rate_mbps,
        link_capacity_mbps
    ):

        if link_capacity_mbps <= 0:
            return 1.0

        utilization = (
            traffic_rate_mbps /
            link_capacity_mbps
        )

        utilization = max(
            0.0,
            min(utilization, 1.0)
        )

        return utilization


    # ========================================================
    # CALCULATE COMPLETE QoS COST
    # ========================================================

    def calculate_cost(
        self,
        delay_ms,
        jitter_ms,
        packet_loss_percent,
        traffic_rate_mbps,
        link_capacity_mbps
    ):

        # ----------------------------------------------------
        # NORMALIZE DELAY
        # ----------------------------------------------------

        delay_normalized = self.normalize(
            delay_ms,
            self.max_delay_ms
        )

        # ----------------------------------------------------
        # NORMALIZE JITTER
        # ----------------------------------------------------

        jitter_normalized = self.normalize(
            jitter_ms,
            self.max_jitter_ms
        )

        # ----------------------------------------------------
        # NORMALIZE PACKET LOSS
        # ----------------------------------------------------

        loss_normalized = self.normalize(
            packet_loss_percent,
            self.max_packet_loss_percent
        )

        # ----------------------------------------------------
        # CALCULATE UTILIZATION
        # ----------------------------------------------------

        utilization = self.calculate_utilization(
            traffic_rate_mbps,
            link_capacity_mbps
        )

        # ----------------------------------------------------
        # WEIGHTED COST
        # ----------------------------------------------------

        delay_cost = (
            self.weight_delay *
            delay_normalized
        )

        jitter_cost = (
            self.weight_jitter *
            jitter_normalized
        )

        loss_cost = (
            self.weight_loss *
            loss_normalized
        )

        utilization_cost = (
            self.weight_utilization *
            utilization
        )

        total_cost = (
            delay_cost +
            jitter_cost +
            loss_cost +
            utilization_cost
        )

        # ----------------------------------------------------
        # RETURN ALL VALUES
        # ----------------------------------------------------

        return {
            "delay_normalized":
                delay_normalized,

            "jitter_normalized":
                jitter_normalized,

            "loss_normalized":
                loss_normalized,

            "utilization":
                utilization,

            "delay_cost":
                delay_cost,

            "jitter_cost":
                jitter_cost,

            "loss_cost":
                loss_cost,

            "utilization_cost":
                utilization_cost,

            "total_cost":
                total_cost
        }


# ============================================================
# TEST
# ============================================================

