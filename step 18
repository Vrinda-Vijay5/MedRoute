import networkx as nx

from qos_cost import QoSCostCalculator


# ============================================================
# MEDROUTE STEP 18
# COST-BASED SDN ROUTING
# ============================================================

class CostBasedRouter:

    def __init__(self):

        self.graph = nx.Graph()

        self.cost_calculator = QoSCostCalculator()

        # All Mininet inter-switch links
        # currently use 10 Mbps capacity.
        self.link_capacity_mbps = 10.0


    # ========================================================
    # CALCULATE LINK COST
    # ========================================================

    def calculate_link_cost(
        self,
        delay_ms,
        jitter_ms,
        packet_loss_percent,
        traffic_rate_mbps
    ):

        result = self.cost_calculator.calculate_cost(
            delay_ms=delay_ms,
            jitter_ms=jitter_ms,
            packet_loss_percent=packet_loss_percent,
            traffic_rate_mbps=traffic_rate_mbps,
            link_capacity_mbps=self.link_capacity_mbps
        )

        return result


    # ========================================================
    # ADD / UPDATE LINK
    # ========================================================

    def update_link(
        self,
        src,
        dst,
        delay_ms,
        jitter_ms,
        packet_loss_percent,
        traffic_rate_mbps
    ):

        result = self.calculate_link_cost(
            delay_ms,
            jitter_ms,
            packet_loss_percent,
            traffic_rate_mbps
        )

        cost = result["total_cost"]

        self.graph.add_edge(
            src,
            dst,
            weight=cost,

            delay=delay_ms,
            jitter=jitter_ms,
            loss=packet_loss_percent,
            traffic_rate=traffic_rate_mbps,

            utilization=result["utilization"]
        )

        print(
            "LINK s{} -> s{} | "
            "delay={:.2f} ms | "
            "jitter={:.2f} ms | "
            "loss={:.2f}% | "
            "traffic={:.2f} Mbps | "
            "utilization={:.2f} | "
            "cost={:.4f}".format(
                src,
                dst,
                delay_ms,
                jitter_ms,
                packet_loss_percent,
                traffic_rate_mbps,
                result["utilization"],
                cost
            )
        )


    # ========================================================
    # FIND MINIMUM-COST PATH
    # ========================================================

    def get_best_path(
        self,
        src,
        dst
    ):

        try:

            path = nx.shortest_path(
                self.graph,
                source=src,
                target=dst,
                weight="weight"
            )

            path_cost = nx.shortest_path_length(
                self.graph,
                source=src,
                target=dst,
                weight="weight"
            )

            return path, path_cost

        except nx.NetworkXNoPath:

            return None, None


    # ========================================================
    # DISPLAY PATH
    # ========================================================

    def display_best_path(
        self,
        src,
        dst
    ):

        path, cost = self.get_best_path(
            src,
            dst
        )

        print("\n------------------------------------------")

        if path is None:

            print(
                "No path available from "
                "s{} to s{}".format(
                    src,
                    dst
                )
            )

            return

        readable_path = " -> ".join(
            "s{}".format(node)
            for node in path
        )

        print(
            "SELECTED PATH :",
            readable_path
        )

        print(
            "TOTAL PATH COST:",
            round(
                cost,
                4
            )
        )

        print("------------------------------------------")


# ============================================================
# TEST SCENARIOS
# ============================================================

if __name__ == "__main__":

    router = CostBasedRouter()

    print("\n==========================================")
    print("MedRoute Step 18")
    print("Dynamic Cost-Based SDN Routing")
    print("==========================================")

    # ========================================================
    # SCENARIO 1
    #
    # Upper path:
