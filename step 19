# ============================================================
# MEDROUTE
# STEP 19 - RULE-BASED HEALTHCARE TRAFFIC CLASSIFICATION
# ============================================================


class HealthCriticalityClassifier:

    # --------------------------------------------------------
    # Traffic classes
    # --------------------------------------------------------

    NORMAL = "NORMAL"
    URGENT = "URGENT"
    CRITICAL = "CRITICAL"


    def classify(
        self,
        heart_rate,
        spo2
    ):

        """
        Classify healthcare traffic using deterministic rules.

        IMPORTANT:
        These thresholds are prototype/test thresholds for
        demonstrating SDN traffic prioritization.
        They are NOT clinical diagnostic thresholds.
        """

        # ====================================================
        # CRITICAL
        # ====================================================

        if (
            heart_rate < 40
            or heart_rate > 140
            or spo2 < 90
        ):

            return self.CRITICAL


        # ====================================================
        # URGENT
        # ====================================================

        if (
            heart_rate < 50
            or heart_rate > 120
            or spo2 < 95
        ):

            return self.URGENT


        # ====================================================
        # NORMAL
        # ====================================================

        return self.NORMAL


    # --------------------------------------------------------
    # Explanation helper
    # --------------------------------------------------------

    def explain(
        self,
        heart_rate,
        spo2
    ):

        criticality = self.classify(
            heart_rate,
            spo2
        )

        return {
            "heart_rate": heart_rate,
            "spo2": spo2,
            "criticality": criticality
        }


