from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.link import TCLink
from mininet.log import setLogLevel, info
from mininet.cli import CLI

import time


def create_network():

    net = Mininet(
        controller=None,
        switch=OVSSwitch,
        link=TCLink,
        autoSetMacs=True,
        build=False
    )

    info("*** Adding remote SDN controller\n")

    c0 = net.addController(
        "c0",
        controller=RemoteController,
        ip="127.0.0.1",
        port=6653
    )

    info("*** Adding hosts\n")

    h1 = net.addHost(
        "h1",
        ip="10.0.0.1/24"
    )

    h2 = net.addHost(
        "h2",
        ip="10.0.0.2/24"
    )

    info("*** Adding OpenFlow switches\n")

    s1 = net.addSwitch(
        "s1",
        protocols="OpenFlow13"
    )

    s2 = net.addSwitch(
        "s2",
        protocols="OpenFlow13"
    )

    s3 = net.addSwitch(
        "s3",
        protocols="OpenFlow13"
    )

    s4 = net.addSwitch(
        "s4",
        protocols="OpenFlow13"
    )

    # ---------------------------------------------------------
    # HOST LINKS
    #
    # Add these FIRST so that:
    #
    # h1 <-> s1 uses s1-eth1
    # h2 <-> s4 uses s4-eth1
    # ---------------------------------------------------------

    info("*** Adding host links\n")

    net.addLink(
        h1,
        s1,
        cls=TCLink,
        bw=10
    )

    net.addLink(
        h2,
        s4,
        cls=TCLink,
        bw=10
    )

    # ---------------------------------------------------------
    # ORIGINAL UPPER PATH
    #
    # s1 -> s2 -> s4
    #
    # Low delay but lossy.
    # ---------------------------------------------------------

    info("*** Adding upper path\n")

    net.addLink(
        s1,
        s2,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=5
    )

    net.addLink(
        s2,
        s4,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=5
    )

    # ---------------------------------------------------------
    # ORIGINAL LOWER PATH
    #
    # s1 -> s3 -> s4
    #
    # Higher delay but no configured loss.
    # ---------------------------------------------------------

    info("*** Adding lower path\n")

    net.addLink(
        s1,
        s3,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    net.addLink(
        s3,
        s4,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    # ---------------------------------------------------------
    # BRAESS CANDIDATE LINK
    #
    # This creates the additional s2 <-> s3 connection.
    #
    # IMPORTANT:
    # Adding this link does NOT itself prove Braess paradox.
    # Later experiments will compare the network with and
    # without this link under comparable traffic demand.
    # ---------------------------------------------------------

    info("*** Adding Braess candidate link s2 <-> s3\n")

    net.addLink(
        s2,
        s3,
        cls=TCLink,
        bw=10,
        delay="1ms",
        loss=0
    )

    info("*** Building network\n")

    net.build()

    info("*** Starting controller\n")
    c0.start()

    info("*** Starting switches\n")

    for switch in [s1, s2, s3, s4]:
        switch.start([c0])

    info("\n")
    info("==========================================\n")
    info("MedRoute Step 22\n")
    info("Braess Candidate-Link SDN Topology\n")
    info("==========================================\n")
    info("\n")

    info("Original paths:\n")
    info("  s1 -> s2 -> s4\n")
    info("  s1 -> s3 -> s4\n")
    info("\n")

    info("Braess candidate link:\n")
    info("  s2 <-> s3\n")
    info("\n")

    info("Waiting for Ryu topology discovery...\n")

    time.sleep(8)

    info("\n*** Testing host connectivity\n")

    result = net.ping(
        hosts=[h1, h2],
        timeout="2"
    )

    info(
        "*** Connectivity test packet loss: "
        "{}%\n".format(result)
    )

    info("\n")
    info("==========================================\n")
    info("Entering Mininet CLI\n")
    info("==========================================\n")

    CLI(net)

    info("*** Stopping network\n")

    net.stop()


if __name__ == "__main__":

    setLogLevel("info")

    create_network()
