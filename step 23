from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.link import TCLink
from mininet.log import setLogLevel, info
from mininet.cli import CLI

import time


CANDIDATE_S2_INTERFACE = "s2-eth3"
CANDIDATE_S3_INTERFACE = "s3-eth3"


def set_candidate_link(s2, s3, enabled):
    """
    Enable or disable the Braess candidate link s2 <-> s3.

    The physical TCLink remains present. Both interfaces are changed
    together so that BASELINE and CANDIDATE experiments use the same
    underlying topology.
    """

    state = "up" if enabled else "down"

    s2.cmd(
        "ip link set dev {} {}".format(
            CANDIDATE_S2_INTERFACE,
            state
        )
    )

    s3.cmd(
        "ip link set dev {} {}".format(
            CANDIDATE_S3_INTERFACE,
            state
        )
    )

    time.sleep(3)

    info(
        "*** Braess candidate link s2 <-> s3: {}\n".format(
            "ON" if enabled else "OFF"
        )
    )


def show_candidate_state(s2, s3):

    info("\n*** Candidate-link interface state\n")

    state_s2 = s2.cmd(
        "ip -br link show {}".format(
            CANDIDATE_S2_INTERFACE
        )
    )

    state_s3 = s3.cmd(
        "ip -br link show {}".format(
            CANDIDATE_S3_INTERFACE
        )
    )

    info(state_s2)
    info(state_s3)


def run_ping_experiment(h1, h2, label):

    info("\n")
    info("=" * 60 + "\n")
    info("{}\n".format(label))
    info("=" * 60 + "\n")

    # -q gives us a compact summary.
    result = h1.cmd(
        "ping -q -c 30 -i 0.1 10.0.0.2"
    )

    info(result)

    info("=" * 60 + "\n")


def create_network():

    net = Mininet(
        controller=None,
        switch=OVSSwitch,
        link=TCLink,
        autoSetMacs=True,
        build=False
    )

    info("*** Adding remote SDN controller\n")

    c0 = net.addController(
        "c0",
        controller=RemoteController,
        ip="127.0.0.1",
        port=6653
    )

    info("*** Adding hosts\n")

    h1 = net.addHost(
        "h1",
        ip="10.0.0.1/24"
    )

    h2 = net.addHost(
        "h2",
        ip="10.0.0.2/24"
    )

    info("*** Adding switches\n")

    s1 = net.addSwitch(
        "s1",
        protocols="OpenFlow13"
    )

    s2 = net.addSwitch(
        "s2",
        protocols="OpenFlow13"
    )

    s3 = net.addSwitch(
        "s3",
        protocols="OpenFlow13"
    )

    s4 = net.addSwitch(
        "s4",
        protocols="OpenFlow13"
    )

    # ---------------------------------------------------------
    # HOST LINKS FIRST
    # ---------------------------------------------------------

    net.addLink(
        h1,
        s1,
        cls=TCLink,
        bw=10
    )

    net.addLink(
        h2,
        s4,
        cls=TCLink,
        bw=10
    )

    # ---------------------------------------------------------
    # UPPER PATH
    # s1 -> s2 -> s4
    # ---------------------------------------------------------

    net.addLink(
        s1,
        s2,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=5
    )

    net.addLink(
        s2,
        s4,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=5
    )

    # ---------------------------------------------------------
    # LOWER PATH
    # s1 -> s3 -> s4
    # ---------------------------------------------------------

    net.addLink(
        s1,
        s3,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    net.addLink(
        s3,
        s4,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    # ---------------------------------------------------------
    # BRAESS CANDIDATE LINK
    # ---------------------------------------------------------

    net.addLink(
        s2,
        s3,
        cls=TCLink,
        bw=10,
        delay="1ms",
        loss=0
    )

    info("*** Building network\n")

    net.build()

    c0.start()

    for switch in [s1, s2, s3, s4]:
        switch.start([c0])

    info("\n")
    info("=" * 60 + "\n")
    info("MEDROUTE - STEP 23\n")
    info("CONTROLLED BRAESS OFF/ON EXPERIMENT\n")
    info("=" * 60 + "\n")

    info("\nWaiting for Ryu discovery...\n")

    time.sleep(8)

    # =========================================================
    # EXPERIMENT A
    # Candidate link OFF
    # =========================================================

    info("\n")
    info("PHASE A: BASELINE NETWORK\n")
    info("------------------------------------------\n")

    set_candidate_link(
        s2,
        s3,
        False
    )

    show_candidate_state(
        s2,
        s3
    )

    # Give Ryu time to process topology change.
    time.sleep(5)

    run_ping_experiment(
        h1,
        h2,
        "BASELINE RESULT - CANDIDATE LINK OFF"
    )

    # =========================================================
    # EXPERIMENT B
    # Candidate link ON
    # =========================================================

    info("\n")
    info("PHASE B: CANDIDATE NETWORK\n")
    info("------------------------------------------\n")

    set_candidate_link(
        s2,
        s3,
        True
    )

    show_candidate_state(
        s2,
        s3
    )

    # Give Ryu time to rediscover link.
    time.sleep(5)

    run_ping_experiment(
        h1,
        h2,
        "CANDIDATE RESULT - CANDIDATE LINK ON"
    )

    info("\n")
    info("=" * 60 + "\n")
    info("STEP 23 EXPERIMENT FINISHED\n")
    info("=" * 60 + "\n")

    info(
        "\nNOTE: Different ping results alone do NOT prove "
        "Braess paradox.\n"
    )

    info(
        "The next stage introduces controlled demand and "
        "system-cost comparison.\n\n"
    )

    CLI(net)

    net.stop()


if __name__ == "__main__":

    setLogLevel("info")

    create_network()
