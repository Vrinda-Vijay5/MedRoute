from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.link import TCLink
from mininet.log import setLogLevel, info
from mininet.cli import CLI

import time


def create_network():

    net = Mininet(
        controller=None,
        switch=OVSSwitch,
        link=TCLink,
        autoSetMacs=True,
        build=False
    )

    info("*** Adding remote SDN controller\n")

    c0 = net.addController(
        "c0",
        controller=RemoteController,
        ip="127.0.0.1",
        port=6653
    )

    # ---------------------------------------------------------
    # HOSPITAL END DEVICES
    # ---------------------------------------------------------

    info("*** Adding hospital hosts\n")

    # Example medical-data sources.
    # These labels represent experimental traffic classes;
    # dataset replay will later drive the classification.
    h1 = net.addHost("h1", ip="10.0.0.1/24")  # NORMAL
    h2 = net.addHost("h2", ip="10.0.0.2/24")  # URGENT
    h3 = net.addHost("h3", ip="10.0.0.3/24")  # CRITICAL

    # Hospital monitoring/server destination
    h4 = net.addHost("h4", ip="10.0.0.4/24")

    # ---------------------------------------------------------
    # SDN SWITCHES
    # ---------------------------------------------------------

    info("*** Adding OpenFlow switches\n")

    s1 = net.addSwitch("s1", protocols="OpenFlow13")
    s2 = net.addSwitch("s2", protocols="OpenFlow13")
    s3 = net.addSwitch("s3", protocols="OpenFlow13")
    s4 = net.addSwitch("s4", protocols="OpenFlow13")

    # ---------------------------------------------------------
    # HOST LINKS FIRST
    # ---------------------------------------------------------

    info("*** Adding host links\n")

    # h1 and h2 enter through s1.
    net.addLink(h1, s1, cls=TCLink, bw=10)
    net.addLink(h2, s1, cls=TCLink, bw=10)

    # h3 enters through s2.
    net.addLink(h3, s2, cls=TCLink, bw=10)

    # Hospital server attached to s4.
    net.addLink(h4, s4, cls=TCLink, bw=10)

    # ---------------------------------------------------------
    # INTER-SWITCH NETWORK
    # ---------------------------------------------------------

    info("*** Adding upper path\n")

    net.addLink(
        s1,
        s2,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=2
    )

    net.addLink(
        s2,
        s4,
        cls=TCLink,
        bw=10,
        delay="5ms",
        loss=2
    )

    info("*** Adding lower path\n")

    net.addLink(
        s1,
        s3,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    net.addLink(
        s3,
        s4,
        cls=TCLink,
        bw=10,
        delay="10ms",
        loss=0
    )

    # ---------------------------------------------------------
    # BRAESS CANDIDATE
    # ---------------------------------------------------------

    info("*** Adding Braess candidate link s2 <-> s3\n")

    net.addLink(
        s2,
        s3,
        cls=TCLink,
        bw=10,
        delay="1ms",
        loss=0
    )

    # ---------------------------------------------------------
    # START NETWORK
    # ---------------------------------------------------------

    info("*** Building network\n")

    net.build()

    c0.start()

    for switch in [s1, s2, s3, s4]:
        switch.start([c0])

    info("\n")
    info("=" * 65 + "\n")
    info("MEDROUTE STEP 25 - MULTI-FLOW HOSPITAL SDN\n")
    info("=" * 65 + "\n")

    info("\nHospital traffic sources:\n")
    info("  h1  10.0.0.1  experimental NORMAL source\n")
    info("  h2  10.0.0.2  experimental URGENT source\n")
    info("  h3  10.0.0.3  experimental CRITICAL source\n")
    info("  h4  10.0.0.4  hospital server\n")

    info("\nAvailable network structure:\n")
    info("  s1 -> s2 -> s4\n")
    info("  s1 -> s3 -> s4\n")
    info("  s2 <-> s3   [Braess candidate]\n")

    info("\nWaiting for Ryu topology discovery...\n")

    time.sleep(8)

    # ---------------------------------------------------------
    # BASIC CONNECTIVITY
    # ---------------------------------------------------------

    info("\n*** Testing hospital-device connectivity\n")

    net.ping(hosts=[h1, h2, h3, h4], timeout="2")

    info("\n")
    info("=" * 65 + "\n")
    info("Entering Mininet CLI\n")
    info("=" * 65 + "\n")

    CLI(net)

    info("*** Stopping network\n")
    net.stop()


if __name__ == "__main__":
    setLogLevel("info")
    create_network()

Notice that we intentionally preserve the Braess candidate:

s2 ↔ s3

but now we have multiple sources:

          h3
           |
          s2
         / | \
        /  |  \
h1 -- s1   |   s4 -- h4
h2 --/  \  |  /
         \ | /
          s3

The source labels are currently controlled experimental labels, not claims that the hosts are actual medical devices. Dataset replay will later supply the healthcare values.

