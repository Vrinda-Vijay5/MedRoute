import networkx as nx

from qos_cost import QoSCostCalculator
from health_criticality import HealthCriticalityClassifier


# ============================================================
# MEDROUTE
# STEP 20
# CRITICALITY-AWARE SDN ROUTING
# ============================================================

class CriticalityAwareRouter:

    def __init__(self):

        self.classifier = HealthCriticalityClassifier()
        self.cost_calculator = QoSCostCalculator()

        self.link_capacity_mbps = 10.0

        # ----------------------------------------------------
        # Prototype SDN QoS policies
        #
        # These are experimental networking weights.
        # They are NOT medical treatment/diagnostic rules.
        # ----------------------------------------------------

        self.qos_policies = {

            "NORMAL": {
                "delay": 0.20,
                "jitter": 0.10,
                "loss": 0.20,
                "utilization": 0.50
            },

            "URGENT": {
                "delay": 0.30,
                "jitter": 0.20,
                "loss": 0.30,
                "utilization": 0.20
            },

            "CRITICAL": {
                "delay": 0.40,
                "jitter": 0.25,
                "loss": 0.30,
                "utilization": 0.05
            }
        }


    # ========================================================
    # CALCULATE COST USING TRAFFIC CLASS
    # ========================================================

    def calculate_cost(
        self,
        traffic_class,
        delay_ms,
        jitter_ms,
        packet_loss_percent,
        traffic_rate_mbps
    ):

        policy = self.qos_policies[
            traffic_class
        ]

        # Normalize delay
        delay_n = self.cost_calculator.normalize(
            delay_ms,
            self.cost_calculator.max_delay_ms
        )

        # Normalize jitter
        jitter_n = self.cost_calculator.normalize(
            jitter_ms,
            self.cost_calculator.max_jitter_ms
        )

        # Normalize loss
        loss_n = self.cost_calculator.normalize(
            packet_loss_percent,
            self.cost_calculator.max_packet_loss_percent
        )

        # Utilization
        utilization = (
            self.cost_calculator.calculate_utilization(
                traffic_rate_mbps,
                self.link_capacity_mbps
            )
        )

        # Criticality-aware cost
        total_cost = (

            policy["delay"] * delay_n

            + policy["jitter"] * jitter_n

            + policy["loss"] * loss_n

            + policy["utilization"] * utilization
        )

        return {
            "delay_n": delay_n,
            "jitter_n": jitter_n,
            "loss_n": loss_n,
            "utilization": utilization,
            "total_cost": total_cost
        }


    # ========================================================
    # BUILD GRAPH FOR ONE TRAFFIC CLASS
    # ========================================================

    def build_graph(
        self,
        traffic_class
    ):

        graph = nx.Graph()

        # ----------------------------------------------------
        # NETWORK CONDITIONS
        #
        # Path A:
        # s1 -> s2 -> s4
        #
        # Better latency/reliability,
        # but HIGH utilization.
        #
        # Path B:
        # s1 -> s3 -> s4
        #
        # Worse latency/reliability,
        # but LOW utilization.
        #
        # This creates a real trade-off.
        # ----------------------------------------------------

        links = [

            # ================================================
            # PATH A
            # Fast/reliable but congested
            # ================================================

            {
                "src": 1,
                "dst": 2,
                "delay": 5.0,
                "jitter": 1.0,
                "loss": 1.0,
                "traffic": 9.0
            },

            {
                "src": 2,
                "dst": 4,
                "delay": 5.0,
                "jitter": 1.0,
                "loss": 1.0,
                "traffic": 9.0
            },

            # ================================================
            # PATH B
            # Less congested but slower / less reliable
            # ================================================

            {
                "src": 1,
                "dst": 3,
                "delay": 25.0,
                "jitter": 8.0,
                "loss": 8.0,
                "traffic": 2.0
            },

            {
                "src": 3,
                "dst": 4,
                "delay": 25.0,
                "jitter": 8.0,
                "loss": 8.0,
                "traffic": 2.0
            }
        ]

        for link in links:

            result = self.calculate_cost(
                traffic_class=traffic_class,
                delay_ms=link["delay"],
                jitter_ms=link["jitter"],
                packet_loss_percent=link["loss"],
                traffic_rate_mbps=link["traffic"]
            )

            graph.add_edge(
                link["src"],
                link["dst"],
                weight=result["total_cost"]
            )

            print(
                "s{} -> s{} | "
                "D={:.1f}ms "
                "J={:.1f}ms "
                "L={:.1f}% "
                "U={:.0f}% "
                "| COST={:.4f}".format(
                    link["src"],
                    link["dst"],
                    link["delay"],
                    link["jitter"],
                    link["loss"],
                    result["utilization"] * 100,
                    result["total_cost"]
                )
            )

        return graph


    # ========================================================
    # FIND BEST PATH
    # ========================================================

    def find_best_path(
        self,
        graph,
        src,
        dst
    ):

        path = nx.shortest_path(
            graph,
            source=src,
            target=dst,
            weight="weight"
        )

        cost = nx.shortest_path_length(
            graph,
            source=src,
            target=dst,
            weight="weight"
        )

        return path, cost


    # ========================================================
    # TEST PATIENT
    # ========================================================

    def test_patient(
        self,
        name,
        heart_rate,
        spo2
    ):

        traffic_class = self.classifier.classify(
            heart_rate,
            spo2
        )

        print("\n==========================================")
        print(name)
        print("==========================================")

        print(
            "Heart Rate    :",
            heart_rate,
            "bpm"
        )

        print(
            "SpO2          :",
            spo2,
            "%"
        )

        print(
            "Traffic Class :",
            traffic_class
        )

        policy = self.qos_policies[
            traffic_class
        ]

        print(
            "QoS Weights   :",
            policy
        )

        print("\nLINK COSTS")
        print("------------------------------------------")

        graph = self.build_graph(
            traffic_class
        )

        path, cost = self.find_best_path(
            graph,
            1,
            4
        )

        readable_path = " -> ".join(
            "s{}".format(node)
            for node in path
        )

        print("\nSELECTED PATH")
        print("------------------------------------------")

        print(
            "Path       :",
            readable_path
        )

        print(
            "Total Cost :",
            round(
                cost,
                4
            )
        )

        return {
            "patient": name,
            "traffic_class": traffic_class,
            "path": path,
            "cost": cost
        }


# ============================================================
# RUN STEP 20 TEST
# ============================================================

if __name__ == "__main__":

    router = CriticalityAwareRouter()

    print("\n==========================================")
    print("MedRoute Step 20")
    print("Criticality-Aware SDN Cost Routing")
    print("==========================================")

    # --------------------------------------------------------
    # NORMAL traffic
    # --------------------------------------------------------

    normal_result = router.test_patient(
        name="Patient A",
        heart_rate=75,
        spo2=98
    )

    # --------------------------------------------------------
    # URGENT traffic
    # --------------------------------------------------------

    urgent_result = router.test_patient(
        name="Patient B",
        heart_rate=125,
        spo2=93
    )

    # --------------------------------------------------------
    # CRITICAL traffic
    # --------------------------------------------------------

    critical_result = router.test_patient(
        name="Patient C",
        heart_rate=150,
        spo2=87
    )

    # ========================================================
    # SUMMARY
    # ========================================================

    print("\n\n==========================================")
    print("STEP 20 ROUTING SUMMARY")
    print("==========================================")

    results = [
        normal_result,
        urgent_result,
        critical_result
    ]

    for result in results:

        readable_path = " -> ".join(
            "s{}".format(node)
            for node in result["path"]
        )

        print(
            "{:<10} | {:<8} | {}".format(
                result["patient"],
                result["traffic_class"],
                readable_path
            )
        )

    print("==========================================")

