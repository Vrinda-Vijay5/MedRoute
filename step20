import networkx as nx

from qos_cost import QoSCostCalculator
from health_criticality import HealthCriticalityClassifier


# ============================================================
# MEDROUTE
# STEP 20 - CRITICALITY-AWARE MULTI-QOS ROUTING
# ============================================================

class CriticalityAwareRouter:

    def __init__(self):

        self.classifier = HealthCriticalityClassifier()
        self.cost_calculator = QoSCostCalculator()

        # Experimental Mininet link capacity
        self.link_capacity_mbps = 10.0

        # ----------------------------------------------------
        # CRITICALITY-SPECIFIC SDN POLICIES
        #
        # These are experimental networking weights.
        # They are NOT clinical recommendations.
        #
        # Every row sums to 1.0.
        # ----------------------------------------------------

        self.qos_policies = {

            "NORMAL": {
                "delay": 0.20,
                "jitter": 0.10,
                "loss": 0.20,
                "utilization": 0.50
            },

            "URGENT": {
                "delay": 0.30,
                "jitter": 0.20,
                "loss": 0.30,
                "utilization": 0.20
            },

            "CRITICAL": {
                "delay": 0.40,
                "jitter": 0.25,
                "loss": 0.30,
                "utilization": 0.05
            }
        }


    # ========================================================
    # CALCULATE CRITICALITY-AWARE LINK COST
    # ========================================================

    def calculate_link_cost(
        self,
        traffic_class,
        delay_ms,
        jitter_ms,
        packet_loss_percent,
        traffic_rate_mbps
    ):

        policy = self.qos_policies[traffic_class]

        # Normalize delay
        delay_n = self.cost_calculator.normalize(
            delay_ms,
            self.cost_calculator.max_delay_ms
        )

        # Normalize jitter
        jitter_n = self.cost_calculator.normalize(
            jitter_ms,
            self.cost_calculator.max_jitter_ms
        )

        # Normalize packet loss
        loss_n = self.cost_calculator.normalize(
            packet_loss_percent,
            self.cost_calculator.max_packet_loss_percent
        )

        # Calculate link utilization
        utilization = self.cost_calculator.calculate_utilization(
            traffic_rate_mbps,
            self.link_capacity_mbps
        )

        # ----------------------------------------------------
        # CRITICALITY-AWARE MULTI-QOS COST
        # ----------------------------------------------------

        total_cost = (
            policy["delay"] * delay_n
            + policy["jitter"] * jitter_n
            + policy["loss"] * loss_n
            + policy["utilization"] * utilization
        )

        return {
            "delay_n": delay_n,
            "jitter_n": jitter_n,
            "loss_n": loss_n,
            "utilization": utilization,
            "total_cost": total_cost
        }


    # ========================================================
    # CREATE NETWORK GRAPH FOR A TRAFFIC CLASS
    # ========================================================

    def build_graph(self, traffic_class):

        graph = nx.Graph()

        # ----------------------------------------------------
        # CONTROLLED NETWORK SCENARIO
        #
        # PATH A:
        # s1 -> s2 -> s4
        #
        # Fast and reliable
        # BUT heavily utilized.
        #
        # PATH B:
        # s1 -> s3 -> s4
        #
        # Slower and less reliable
        # BUT lightly utilized.
        #
        # This deliberate trade-off allows different
        # criticality classes to select different paths.
        # ----------------------------------------------------

        links = [

            # ---------------- PATH A ----------------

            {
                "src": 1,
                "dst": 2,
                "delay": 5.0,
                "jitter": 1.0,
                "loss": 1.0,
                "traffic": 9.0
            },

            {
                "src": 2,
                "dst": 4,
                "delay": 5.0,
                "jitter": 1.0,
                "loss": 1.0,
                "traffic": 9.0
            },

            # ---------------- PATH B ----------------

            {
                "src": 1,
                "dst": 3,
                "delay": 25.0,
                "jitter": 8.0,
                "loss": 8.0,
                "traffic": 2.0
            },

            {
                "src": 3,
                "dst": 4,
                "delay": 25.0,
                "jitter": 8.0,
                "loss": 8.0,
                "traffic": 2.0
            }
        ]

        for link in links:

            result = self.calculate_link_cost(
                traffic_class=traffic_class,
                delay_ms=link["delay"],
                jitter_ms=link["jitter"],
                packet_loss_percent=link["loss"],
                traffic_rate_mbps=link["traffic"]
            )

            graph.add_edge(
                link["src"],
                link["dst"],
                weight=result["total_cost"],
                delay=link["delay"],
                jitter=link["jitter"],
                loss=link["loss"],
                utilization=result["utilization"]
            )

            print(
                "s{} -> s{} | "
                "Delay={:.1f} ms | "
                "Jitter={:.1f} ms | "
                "Loss={:.1f}% | "
                "Util={:.0f}% | "
                "Cost={:.4f}".format(
                    link["src"],
                    link["dst"],
                    link["delay"],
                    link["jitter"],
                    link["loss"],
                    result["utilization"] * 100,
                    result["total_cost"]
                )
            )

        return graph


    # ========================================================
    # FIND MINIMUM-COST PATH
    # ========================================================

    def find_best_path(self, graph, src, dst):

        path = nx.shortest_path(
            graph,
            source=src,
            target=dst,
            weight="weight"
        )

        path_cost = nx.shortest_path_length(
            graph,
            source=src,
            target=dst,
            weight="weight"
        )

        return path, path_cost


    # ========================================================
    # TEST ONE PATIENT
    # ========================================================

    def test_patient(
        self,
        patient_name,
        heart_rate,
        spo2
    ):

        traffic_class = self.classifier.classify(
            heart_rate,
            spo2
        )

        print("\n")
        print("=" * 60)
        print(patient_name)
        print("=" * 60)

        print("Heart Rate     :", heart_rate, "bpm")
        print("SpO2           :", spo2, "%")
        print("Traffic Class  :", traffic_class)

        policy = self.qos_policies[traffic_class]

        print("\nSDN QoS Policy")
        print("------------------------------------------")
        print("Delay Weight       :", policy["delay"])
        print("Jitter Weight      :", policy["jitter"])
        print("Loss Weight        :", policy["loss"])
        print("Utilization Weight :", policy["utilization"])

        print("\nCalculated Link Costs")
        print("------------------------------------------")

        graph = self.build_graph(traffic_class)

        path, path_cost = self.find_best_path(
            graph,
            1,
            4
        )

        readable_path = " -> ".join(
            "s{}".format(node)
            for node in path
        )

        print("\nSelected SDN Route")
        print("------------------------------------------")
        print("Path       :", readable_path)
        print("Total Cost :", round(path_cost, 4))

        return {
            "patient": patient_name,
            "traffic_class": traffic_class,
            "path": path,
            "cost": path_cost
        }


# ============================================================
# STEP 20 TEST
# ============================================================

if __name__ == "__main__":

    router = CriticalityAwareRouter()

    print("\n")
