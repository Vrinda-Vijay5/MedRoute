Then replace the controller with this Step 9 version:

cat > controller/medroute_controller.py <<'EOF'
from ryu.base import app_manager
from ryu.controller import ofp_event
from ryu.controller.handler import CONFIG_DISPATCHER, MAIN_DISPATCHER
from ryu.controller.handler import set_ev_cls
from ryu.ofproto import ofproto_v1_3
from ryu.lib.packet import packet, ethernet, arp, ipv4
from ryu.lib.packet import ether_types

from ryu.topology import event
from ryu.topology.api import get_switch, get_link

import networkx as nx


class MedRouteController(app_manager.RyuApp):

    OFP_VERSIONS = [ofproto_v1_3.OFP_VERSION]

    def __init__(self, *args, **kwargs):
        super(MedRouteController, self).__init__(*args, **kwargs)

        self.logger.info("============================")
        self.logger.info("MedRoute Controller Started")
        self.logger.info("============================")

        self.graph = nx.DiGraph()
        self.datapaths = {}

        self.host_switch = {
            "10.0.0.1": 1,
            "10.0.0.2": 4
        }

        self.host_port = {
            "10.0.0.1": 1,
            "10.0.0.2": 1
        }

        self.port_map = {}

    @set_ev_cls(
        ofp_event.EventOFPSwitchFeatures,
        CONFIG_DISPATCHER
    )
    def switch_connected(self, ev):

        datapath = ev.msg.datapath

        self.datapaths[datapath.id] = datapath

        self.logger.info(
            "Switch connected: s%d",
            datapath.id
        )

        parser = datapath.ofproto_parser
        ofproto = datapath.ofproto

        match = parser.OFPMatch()

        actions = [
            parser.OFPActionOutput(
                ofproto.OFPP_CONTROLLER,
                ofproto.OFPCML_NO_BUFFER
            )
        ]

        self.add_flow(
            datapath,
            priority=0,
            match=match,
            actions=actions
        )

    def add_flow(
        self,
        datapath,
        priority,
        match,
        actions
    ):

        parser = datapath.ofproto_parser

        instructions = [
            parser.OFPInstructionActions(
                datapath.ofproto.OFPIT_APPLY_ACTIONS,
                actions
            )
        ]

        mod = parser.OFPFlowMod(
            datapath=datapath,
            priority=priority,
            match=match,
            instructions=instructions
        )

        datapath.send_msg(mod)

    @set_ev_cls(
        event.EventSwitchEnter
    )
    def topology_changed(self, ev):

        self.logger.info("Topology discovery triggered")

        self.update_topology()

    def update_topology(self):

        self.graph.clear()
        self.port_map.clear()

        switches = get_switch(self, None)

        for switch in switches:

            switch_id = switch.dp.id

            self.graph.add_node(switch_id)

        links = get_link(self, None)

        for link in links:

            src = link.src.dpid
            dst = link.dst.dpid
            src_port = link.src.port_no

            self.graph.add_edge(
                src,
                dst,
                weight=1
            )

            self.port_map[
                (src, dst)
            ] = src_port

            self.logger.info(
                "Link discovered: s%d:%d -> s%d",
                src,
                src_port,
                dst
            )

        self.logger.info(
            "Discovered switches: %s",
            list(self.graph.nodes())
        )

        self.logger.info(
            "Discovered links: %s",
            list(self.graph.edges())
        )

    @set_ev_cls(
        ofp_event.EventOFPPacketIn,
        MAIN_DISPATCHER
    )
    def packet_in_handler(self, ev):

        msg = ev.msg

        datapath = msg.datapath
        in_port = msg.match["in_port"]

        pkt = packet.Packet(msg.data)

        eth = pkt.get_protocol(ethernet.ethernet)

        if eth.ethertype == ether_types.ETH_TYPE_LLDP:
            return

        arp_pkt = pkt.get_protocol(arp.arp)

        if arp_pkt:

            self.handle_arp(
                msg,
                datapath,
                in_port,
                arp_pkt
            )

            return

        ipv4_pkt = pkt.get_protocol(ipv4.ipv4)

        if ipv4_pkt:

            self.handle_ipv4(
                msg,
                datapath,
                in_port,
                ipv4_pkt
            )

    def handle_arp(
        self,
        msg,
        datapath,
        in_port,
        arp_pkt
    ):

        src_ip = arp_pkt.src_ip
        dst_ip = arp_pkt.dst_ip

        self.logger.info(
            "ARP: %s -> %s",
            src_ip,
            dst_ip
        )

        if dst_ip not in self.host_switch:
            return

        dst_switch = self.host_switch[dst_ip]
        dst_port = self.host_port[dst_ip]

        parser = datapath.ofproto_parser
        ofproto = datapath.ofproto

        if datapath.id == dst_switch:

            actions = [
                parser.OFPActionOutput(dst_port)
            ]

        else:

            try:

                path = nx.shortest_path(
                    self.graph,
                    source=datapath.id,
                    target=dst_switch,
                    weight="weight"
                )

            except nx.NetworkXNoPath:

                self.logger.warning(
                    "No ARP path from s%d to s%d",
                    datapath.id,
                    dst_switch
                )

                return

            next_switch = path[1]

            out_port = self.port_map[
                (datapath.id, next_switch)
            ]

            actions = [
                parser.OFPActionOutput(out_port)
            ]

        out = parser.OFPPacketOut(
            datapath=datapath,
            buffer_id=msg.buffer_id,
            in_port=in_port,
            actions=actions,
            data=msg.data
            if msg.buffer_id == ofproto.OFP_NO_BUFFER
            else None
        )

        datapath.send_msg(out)

    def handle_ipv4(
        self,
        msg,
        datapath,
        in_port,
        ipv4_pkt
    ):

        src_ip = ipv4_pkt.src
        dst_ip = ipv4_pkt.dst

        if (
            src_ip not in self.host_switch
            or dst_ip not in self.host_switch
        ):

            return

        src_sw = self.host_switch[src_ip]
        dst_sw = self.host_switch[dst_ip]

        try:

            path = nx.shortest_path(
                self.graph,
                source=src_sw,
                target=dst_sw,
                weight="weight"
            )

        except nx.NetworkXNoPath:

            self.logger.warning(
                "No path from %s to %s",
                src_ip,
                dst_ip
            )

            return

        self.logger.info(
            "Route %s -> %s : %s",
            src_ip,
            dst_ip,
            path
        )

        self.install_path(
            path,
            src_ip,
            dst_ip
        )

        self.forward_first_packet(
            msg,
            datapath,
            in_port,
            path,
            dst_ip
        )

    def install_path(
        self,
        path,
        src_ip,
        dst_ip
    ):

        for i, switch_id in enumerate(path):

            datapath = self.datapaths[switch_id]

            parser = datapath.ofproto_parser

            if i == len(path) - 1:

                out_port = self.host_port[dst_ip]

            else:

                next_switch = path[i + 1]

                out_port = self.port_map[
                    (switch_id, next_switch)
                ]

            match = parser.OFPMatch(
                eth_type=0x0800,
                ipv4_src=src_ip,
                ipv4_dst=dst_ip
            )

            actions = [
                parser.OFPActionOutput(out_port)
            ]

            self.add_flow(
                datapath,
                priority=10,
                match=match,
                actions=actions
            )

    def forward_first_packet(
        self,
        msg,
        datapath,
        in_port,
        path,
        dst_ip
    ):

        current_switch = datapath.id

        try:

            i = path.index(current_switch)

        except ValueError:

            return

        if i == len(path) - 1:

            out_port = self.host_port[dst_ip]

        else:

            next_switch = path[i + 1]

            out_port = self.port_map[
                (current_switch, next_switch)
            ]

        parser = datapath.ofproto_parser
        ofproto = datapath.ofproto

        actions = [
            parser.OFPActionOutput(out_port)
        ]

        out = parser.OFPPacketOut(
            datapath=datapath,
            buffer_id=msg.buffer_id,
            in_port=in_port,
            actions=actions,
            data=msg.data
            if msg.buffer_id == ofproto.OFP_NO_BUFFER
            else None
        )

        datapath.send_msg(out)
