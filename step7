import time


class CongestionMonitor:

    def __init__(self):
        self.link_stats = {}

    def calculate_congestion(self, bandwidth, used_bandwidth):

        if bandwidth <= 0:
            return 0

        utilization = used_bandwidth / bandwidth

        if utilization > 1:
            utilization = 1

        return utilization

    def classify_congestion(self, utilization):

        if utilization < 0.30:
            return "LOW"

        elif utilization < 0.70:
            return "MEDIUM"

        else:
            return "HIGH"

    def update_link(self, src, dst, bandwidth, used_bandwidth):

        utilization = self.calculate_congestion(
            bandwidth,
            used_bandwidth
        )

        level = self.classify_congestion(utilization)

        self.link_stats[(src, dst)] = {
            "bandwidth": bandwidth,
            "used_bandwidth": used_bandwidth,
            "utilization": utilization,
            "congestion": level,
            "timestamp": time.time()
        }

        return self.link_stats[(src, dst)]

    def get_link_status(self, src, dst):

        return self.link_stats.get(
            (src, dst),
            None
        )


if __name__ == "__main__":

    monitor = CongestionMonitor()

    tests = [
        (10, 2),
        (10, 5),
        (10, 8)
    ]

    print("============================")
    print("MedRoute Congestion Monitor")
    print("============================")

    for bandwidth, used in tests:

        result = monitor.update_link(
            1,
            2,
            bandwidth,
            used
        )

        print(
            "Link: s1 -> s2 | "
            "Utilization: {:.0f}% | "
            "Congestion: {}".format(
                result["utilization"] * 100,
